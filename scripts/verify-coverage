#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

mkdir -p .clouseau-work
node src/native-test-report.cjs coverage "$PWD/.clouseau-work/verification-runs" -- \
  --experimental-test-coverage --test \
  --test-reporter=lcov --test-reporter-destination=.clouseau-work/node.lcov \
  --test-coverage-lines=100 --test-coverage-branches=100 \
  --test-coverage-include='src/**/*.cjs' \
  --test-coverage-include='src/**/*.js' \
  --test-coverage-include='src/**/*.mjs' \
  --test-coverage-exclude='src/**/*.test.*' \
  --test-coverage-exclude='src/**/*.spec.*' \
  --import ./test/load-sources.mjs src/*.test.cjs
